# ==============================================================================
# NEUROCARE NEXUS — BACKEND ENVIRONMENT CONFIGURATION (TEMPLATE)
# Copy this file to .env and supply actual values for your deployment environment.
# DO NOT commit real secrets or credentials to source control.
# ==============================================================================

# --- Core Django Settings ---
DEBUG=False
SECRET_KEY=your_generated_cryptographic_secret_key_here_min_50_chars
ALLOWED_HOSTS=localhost,127.0.0.1,your-app-service.azurewebsites.net

# --- Database (PostgreSQL) ---
DB_NAME=neurocare_nexus
DB_USER=neurocare_admin
DB_PASSWORD=your_secure_db_password_here
DB_HOST=your-postgres-flexible-server.postgres.database.azure.com
DB_PORT=5432
DB_SSL_REQUIRE=True

# --- Django Channels & Redis ---
# For local dev without Redis, leave blank to use InMemoryChannelLayer.
# In production on Azure, set your Azure Cache for Redis connection URL.
REDIS_URL=rediss://:your_redis_auth_key@your-redis-cache.redis.cache.windows.net:6380/0

# --- Authentication & JWT ---
# Use a strong cryptographic key (minimum 32 bytes for HS256)
JWT_SECRET=your_secure_jwt_signing_secret_here_min_32_bytes_long!

# --- CORS & CSRF ---
CORS_ALLOW_ALL_ORIGINS=False
CORS_ALLOWED_ORIGINS=http://localhost:5173,https://your-frontend.azurestaticapps.net
CSRF_TRUSTED_ORIGINS=https://your-frontend.azurestaticapps.net,https://your-app-service.azurewebsites.net

# --- Security Headers (Production) ---
SECURE_SSL_REDIRECT=True
SECURE_HSTS_SECONDS=31536000

# --- Email Notification Service (Optional) ---
EMAIL_ENABLED=False
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=your_email@gmail.com
EMAIL_HOST_PASSWORD=your_app_password
DEFAULT_FROM_EMAIL=neurocarenexus@gmail.com
ADMIN_NOTIFICATION_EMAIL=neurocarenexus@gmail.com
DEV_OVERRIDE_EMAIL=
