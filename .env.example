# ==============================================================================
# NEUROCARE NEXUS — FRONTEND ENVIRONMENT CONFIGURATION (TEMPLATE)
# Copy this file to .env or .env.production and configure for your environment.
# ==============================================================================

# REST API Base URL (includes /api suffix)
# Local development default:
VITE_API_URL=http://127.0.0.1:8000/api
# Production Azure App Service example:
# VITE_API_URL=https://your-backend-app.azurewebsites.net/api

# WebSocket Base URL (does NOT include endpoint path)
# Local development default:
VITE_WS_URL=ws://127.0.0.1:8000
# Production Azure App Service example:
# VITE_WS_URL=wss://your-backend-app.azurewebsites.net
